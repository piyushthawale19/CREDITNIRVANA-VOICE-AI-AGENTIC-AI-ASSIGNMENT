{
  "name": "nirvana-voice-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/index.js -k -n api,ui \"node server/index.js\" \"node node_modules/vite/bin/vite.js --host 0.0.0.0\"",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 tests/agent.test.js tests/api.test.js tests/telephony.test.js",
    "lint": "node node_modules/typescript/bin/tsc --noEmit",
    "prompts": "node scripts/export-prompts.js"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "latest",
    "better-sqlite3": "latest",
    "concurrently": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "lucide-react": "latest",
    "motion": "^14.6.0",
    "react": "latest",
    "react-dom": "latest",
    "react-is": "^19.3.1",
    "react-router-dom": "latest",
    "recharts": "latest",
    "three": "^0.186.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
