# Server
PORT=8787
NODE_ENV=development
# Required in production. Use a long random value, e.g. `openssl rand -hex 48`.
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated browser origins allowed to call the API with cookies.
APP_ORIGIN=http://localhost:5173,http://localhost:4173

# Sarvam AI — server-side only, never exposed to the browser.
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3

# Telephony Provider Configuration
# Set TELEPHONY_PROVIDER to 'twilio', 'exotel', or 'mock' (default: mock sandbox).
TELEPHONY_PROVIDER=mock
# Public webhook base URL (e.g. your ngrok tunnel URL or domain) for carrier status/voice callbacks
TELEPHONY_WEBHOOK_BASE_URL=http://localhost:8787
TELEPHONY_WEBHOOK_SECRET=

# Option A: Twilio Voice & Recording Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option B: Exotel Indian Telephony Configuration
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=

# Storage & Call Recordings
DATABASE_PATH=./data/nirvana.sqlite
RECORDINGS_DIR=./data/recordings
